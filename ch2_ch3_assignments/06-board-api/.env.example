# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.

# Supabase > Project Settings > Database > Connection string > "Session pooler" 주소를 사용합니다.
# 앞부분을 postgresql:// 에서 postgresql+asyncpg:// 로 바꿔 주세요.
# (Transaction pooler(6543)를 쓰려면 database.py 의 주석대로 statement_cache_size=0 설정이 필요합니다)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# JWT 서명용 비밀 키 - 아래 명령으로 랜덤 문자열을 만들어 넣으세요.
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# (선택) 커넥션 풀 크기 / SQL 로그 출력
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_ECHO=false
