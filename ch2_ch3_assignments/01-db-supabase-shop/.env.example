# .env.example : 이 파일을 복사해서 .env 를 만들고 실제 값을 채운다 (.env 는 GitHub 에 올리지 않음)
# Supabase 대시보드 > Project Settings > API (Data API / API Keys) 에서 확인
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# main.py 데모에서 사용할 연습용 테스트 계정 (실제로 쓰는 비밀번호를 넣지 말 것)
DEMO_EMAIL=demo_user@example.com
DEMO_PASSWORD=password1234
